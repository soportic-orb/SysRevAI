# ─────────────────────────────────────────────────────────────────────────────
# SysRevAI — Environment configuration
#
# This file is written automatically by the web installer (Step 7).
# You normally do NOT need to edit it by hand. Copy it to ".env" only if you
# want to provision the app without running the web installer.
#
# IMPORTANT: ".env" is git-ignored. NEVER commit real credentials.
#
# External service credentials (Claude API, Google Translate, SMTP, …) are NOT
# stored here — they live encrypted in the database and are configured from the
# admin panel (Settings → Integrations) after installation.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME="SysRevAI"
APP_ENV=production            # production | development
APP_DEBUG=false               # true enables verbose error output (dev only)
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Madrid
APP_LOCALE=ca                 # default UI language: ca | es | en

# Encryption key — used for AES-256-GCM encryption of sensitive settings.
# Generated automatically by the installer. 32 bytes, base64-encoded.
# To generate manually: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sysrevai
DB_USERNAME=sysrevai
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_PREFIX=sra_                 # table prefix (lets you share a DB with other apps)

# Security
FORCE_HTTPS=false             # true to redirect all traffic to HTTPS
SESSION_LIFETIME=120          # minutes of inactivity before logout
