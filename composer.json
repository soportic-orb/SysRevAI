{
    "name": "soportic-orb/sysrevai",
    "description": "SysRevAI — Self-hosted systematic literature review platform powered by AI (Claude) and automatic translation. A Covidence-inspired alternative.",
    "type": "project",
    "keywords": [
        "systematic-review",
        "prisma",
        "literature-review",
        "covidence",
        "research",
        "ai",
        "claude",
        "self-hosted"
    ],
    "homepage": "https://github.com/soportic-orb/sysrevai",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "guzzlehttp/guzzle": "^7.8",
        "smalot/pdfparser": "^2.10",
        "phpoffice/phpword": "^1.2",
        "phpoffice/phpspreadsheet": "^2.1",
        "dompdf/dompdf": "^3.0",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.51"
    },
    "autoload": {
        "psr-4": {
            "SysRevAI\\": "src/"
        },
        "files": [
            "src/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SysRevAI\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
